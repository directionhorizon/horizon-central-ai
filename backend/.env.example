# Copiez ce fichier en .env local. Ne versionnez jamais le vrai .env.
HORIZON_DATABASE_PATH=./data/horizon.db
HORIZON_API_HOST=127.0.0.1
HORIZON_API_PORT=8000
HORIZON_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Fournisseurs IA -------------------------------------------------------
# Les fournisseurs sont enregistres via l'API (/api/v1/models) et stockes en base.
# La base ne contient JAMAIS la cle : uniquement le NOM de la variable
# d'environnement qui la contient (champ api_key_env).
# Exemple : un fournisseur declare avec api_key_env=HORIZON_LLM_API_KEY lira
# la valeur ci-dessous. Laissez vide tant qu'aucun fournisseur n'est valide.
HORIZON_LLM_API_KEY=

# Convention multi-fournisseurs : une variable par fournisseur, et la fiche
# correspondante declare son nom dans api_key_env. Ainsi plusieurs cles
# coexistent sans conflit (aucune cle n'est jamais reutilisee pour un autre
# fournisseur).
HORIZON_GEMINI_API_KEY=
# HORIZON_OPENAI_API_KEY=
# HORIZON_ANTHROPIC_API_KEY=
# HORIZON_GROQ_API_KEY=
# HORIZON_OPENROUTER_API_KEY=

# Variables heritees de la version 0.1.0 : conservees pour compatibilite.
HORIZON_LLM_BASE_URL=
HORIZON_LLM_MODEL=

# --- Orchestrateur Hermes (execution reelle des missions) -------------------
# Cle du listener API de Hermes (http://127.0.0.1:8642). La base ne stocke
# JAMAIS la valeur : l'orchestrateur ne reference que le NOM de cette variable
# (config.api_key_env = HERMES_API_SERVER_KEY). La valeur reste donc ici,
# jamais versionnee. Requise uniquement pour lancer et suivre une execution
# reelle (POST /api/v1/missions/{id}/dispatch) ; la verification de sante
# (POST /api/v1/orchestrators/{id}/check) fonctionne sans elle.
HERMES_API_SERVER_KEY=

# --- Synchronisation distante (optionnelle, Offline-First) ------------------
# HORIZON fonctionne integralement SANS ces variables. Si elles sont vides,
# aucune synchronisation distante n'a lieu : la file locale est conservee.
# Si elles sont renseignees, POST /api/v1/sync/push et /pull deviennent actifs.
# La cle n'est jamais ecrite en base, uniquement lue ici.
HORIZON_SUPABASE_URL=
HORIZON_SUPABASE_KEY=

# Sonde de connectivite (TCP court, aucun service payant). Format hote:port.
HORIZON_CONNECTIVITY_PROBE=1.1.1.1:443

# Synchronisation automatique quand la connexion revient. Desactivee par defaut.
# Activer avec HORIZON_SYNC_AUTO=1 (necessite aussi le fournisseur ci-dessus).
HORIZON_SYNC_AUTO=0
HORIZON_SYNC_INTERVAL_S=120

# --- Securite --------------------------------------------------------------
# Jeton administrateur unique. Si vide, l'API reste ouverte sur 127.0.0.1
# (mono-poste). Si renseigne, toute operation d'ecriture exige
# Authorization: Bearer <jeton> ou X-Horizon-Token: <jeton>.
HORIZON_ADMIN_TOKEN=

# --- Connecteurs externes (optionnels) --------------------------------------
# Les valeurs restent ici (jamais en base, jamais dans l'interface, jamais dans
# les journaux). Sans configuration, la main correspondante refuse honnetement.

# Recherche web. AUCUNE variable n'est obligatoire : sans configuration, la main
# utilise un repli SANS CLE (DuckDuckGo). Pour un moteur robuste, renseignez :
# - HORIZON_SEARCH_URL : instance SearXNG (gratuit, sans cle) ;
# - ou HORIZON_BRAVE_SEARCH_KEY : Brave Search (palier gratuit).
HORIZON_SEARCH_URL=
HORIZON_BRAVE_SEARCH_KEY=

# Envoi d'e-mail (SMTP). Un jeu de reglages par compte (Gmail, Outlook, ...).
# HORIZON_SMTP_SECURITY : starttls (defaut, port 587) ou ssl (port 465).
HORIZON_SMTP_HOST=
HORIZON_SMTP_PORT=587
HORIZON_SMTP_SECURITY=starttls
HORIZON_SMTP_USER=
HORIZON_SMTP_PASSWORD=
HORIZON_SMTP_FROM=

# Bot Telegram (le plus simple et gratuit). chat_id par defaut facultatif.
HORIZON_TELEGRAM_BOT_TOKEN=
HORIZON_TELEGRAM_CHAT_ID=

# --- Connexion AUTOMATIQUE (OAuth) des reseaux sociaux ----------------------
# NOTE : les URLs de redirection doivent correspondre a l'environnement courant.
#  - en local       : http://127.0.0.1:8000/api/v1/integrations/oauth/<prov>/callback
#  - sur le serveur : https://<votre-sous-domaine>/api/v1/integrations/oauth/<prov>/callback
# Enregistrez les DEUX dans la console du fournisseur (Google/Meta/TikTok).
# Creez une application chez Meta et chez TikTok, puis renseignez ci-dessous.
# L'URL de redirection doit etre declaree a l'identique chez le fournisseur.
# Aucun jeton n'est saisi a la main : cliquez "Connecter" dans l'interface.
HORIZON_META_APP_ID=
HORIZON_META_APP_SECRET=
HORIZON_META_REDIRECT_URI=http://127.0.0.1:8000/api/v1/integrations/oauth/meta/callback
HORIZON_TIKTOK_CLIENT_KEY=
HORIZON_TIKTOK_CLIENT_SECRET=
HORIZON_TIKTOK_REDIRECT_URI=http://127.0.0.1:8000/api/v1/integrations/oauth/tiktok/callback

# Gmail (Google) : envoi d'e-mail SANS mot de passe (jeton OAuth). Reutilise le
# client Google. Declarez l'URL de redirection ci-dessous dans la console Google.
HORIZON_GOOGLE_CLIENT_SECRET=
HORIZON_GOOGLE_REDIRECT_URI=http://127.0.0.1:8000/api/v1/integrations/oauth/google/callback

# Facebook / Instagram (Meta) : un jeton par Page/compte. Instagram Business est
# lie a une Page : le meme jeton sert pour les deux. Pour PLUSIEURS comptes, ne
# creez pas plusieurs variables ici : creez une fiche par compte dans le
# registre des integrations (page "Connexions"), chacune avec son api_key_env.
HORIZON_META_ACCESS_TOKEN=
HORIZON_META_PAGE_ID=
HORIZON_META_IG_USER_ID=

# TikTok : un jeton d'acces par compte (OAuth via Client Key/Secret de l'app).
HORIZON_TIKTOK_ACCESS_TOKEN=

# Generation d'images (service compatible /images/generations : Replicate, fal.ai,
# OpenAI, Together AI...). HORIZON_IMAGE_MODEL : nom du modele.
# Exemple Together AI : HORIZON_IMAGE_BASE_URL=https://api.together.xyz/v1
#                      HORIZON_IMAGE_MODEL=black-forest-labs/FLUX.1-schnell
# (le format « 1024x1024 » est converti en width/height pour Together).
# Exemple gratuit sans cle : HORIZON_IMAGE_BASE_URL=https://image.pollinations.ai
# (aucune cle requise ; la main renvoie une URL d'image servie par Pollinations).
HORIZON_IMAGE_BASE_URL=
HORIZON_IMAGE_API_KEY=
HORIZON_IMAGE_MODEL=

# Paiement Stripe (validation humaine obligatoire avant execution).
HORIZON_STRIPE_SECRET_KEY=
HORIZON_STRIPE_WEBHOOK_SECRET=
# MoneyFusion (Mobile Money MTN/Airtel + carte Visa, Congo) : URL de l'application
# générée dans le dashboard FusionPay, menu « API de paiement ». C'est un secret.
HORIZON_MONEYFUSION_API_URL=
# Fournisseur par défaut : stripe | paypal | mollie | moneyfusion
HORIZON_PAYMENT_PROVIDER=stripe

# MAYELA CRM (lecture seule des flux via vues Supabase). L'URL et la cle anon
# sont publiques ; le jeton est un JWT signe pour le role `horizon_reader`
# (genere par scripts/make_supabase_jwt.py). Aucun droit d'ecriture.
HORIZON_MAYELA_SUPABASE_URL=
HORIZON_MAYELA_SUPABASE_ANON_KEY=
HORIZON_MAYELA_SUPABASE_TOKEN=

# SasPay (Mobile Money + carte, Afrique de l'Ouest et du Centre). La cle API
# (sk_test_... en bac a sable, sk_live_... en production) et le secret de
# signature du webhook ne sont jamais versionnes ni journalises.
# Laisser HORIZON_SASPAY_BASE_URL vide pour viser la production ; mettre
# https://sandbox-api.saspay.me/api/v1 pour tester sans argent reel.
HORIZON_SASPAY_API_KEY=
HORIZON_SASPAY_WEBHOOK_SECRET=
HORIZON_SASPAY_BASE_URL=
