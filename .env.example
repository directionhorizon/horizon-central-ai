# HORIZON LOCAL AI — configuration frontend (Vite)
# Copier ce fichier en `.env` seulement si le frontend tourne séparément
# (`npm run dev`). En production, laisser la valeur vide : l'interface est
# servie par le backend, les appels API sont relatifs et fonctionnent aussi
# bien en local que derrière un domaine HTTPS.
#
# Aucun secret ne doit être placé ici : seules des URL publiques sont lues
# par le frontend.

# Vide ou absent = même origine que l'interface (recommandé)
VITE_HORIZON_API_URL=

# Délai maximal par requête, en millisecondes
VITE_HORIZON_API_TIMEOUT_MS=8000
